// Version information for the DLLs in the DLCoop package (Properties > Details in Windows Explorer).
// Values in dlcoop_info.h, written by build.ps1 for each DLL (version: <Version> from DLCoop.csproj).
// No DLL claims to be a Microsoft or Techland component: winmm.dll declares itself a DLCoop mod loader
// (a file that impersonates a system component is exactly what antivirus software flags).
#include <winver.h>
#include "dlcoop_info.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DLCOOP_VER
 PRODUCTVERSION DLCOOP_VER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DLCoop"
            VALUE "FileDescription", DLCOOP_DESC
            VALUE "FileVersion", DLCOOP_VER_STR
            VALUE "InternalName", DLCOOP_NAME
            VALUE "LegalCopyright", "Personal mod for Dying Light 1.55. Not affiliated with Techland."
            VALUE "OriginalFilename", DLCOOP_FILE
            VALUE "ProductName", "DLCoop"
            VALUE "ProductVersion", DLCOOP_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
