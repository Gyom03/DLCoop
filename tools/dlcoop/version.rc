// Informations de version des DLL du paquet DLCoop (Propriétés > Détails dans l'explorateur de Windows).
// Valeurs dans dlcoop_info.h, écrit par build.ps1 pour chaque DLL (version : <Version> de DLCoop.csproj).
// Aucune DLL ne se présente comme un composant de Microsoft ou de Techland : winmm.dll se déclare chargeur de
// mods DLCoop (un fichier qui usurpe l'identité d'un composant système est justement ce que les antivirus repèrent).
#include <winver.h>
#include "dlcoop_info.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DLCOOP_VER
 PRODUCTVERSION DLCOOP_VER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DLCoop"
            VALUE "FileDescription", DLCOOP_DESC
            VALUE "FileVersion", DLCOOP_VER_STR
            VALUE "InternalName", DLCOOP_NAME
            VALUE "LegalCopyright", "Personal mod for Dying Light 1.55. Not affiliated with Techland."
            VALUE "OriginalFilename", DLCOOP_FILE
            VALUE "ProductName", "DLCoop"
            VALUE "ProductVersion", DLCOOP_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
