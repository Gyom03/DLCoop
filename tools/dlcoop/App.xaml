<Application x:Class="DLCoop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup" ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="Fond" Color="#1E1F22"/>
        <SolidColorBrush x:Key="Carte" Color="#2B2D31"/>
        <SolidColorBrush x:Key="Texte" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="Pale" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="Accent" Color="#E8A33D"/>
        <SolidColorBrush x:Key="Ok" Color="#6CC57C"/>
        <SolidColorBrush x:Key="Erreur" Color="#E5675F"/>

        <!-- No implicit TextBlock style here: at the application level it would also apply to the text INSIDE
             buttons and combo boxes (light background) -> white on white. It lives in the window. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1F22"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Texte}"/>
            <Setter Property="BorderBrush" Value="#44474D"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Carte}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Dark buttons (light text on dark background), "Launch" in the accent color -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Background" Value="#3A3D42"/>
            <Setter Property="BorderBrush" Value="#4A4E55"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cadre" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Expanders (secondary options): clickable header "▸ Title" / "▾ Title", dark theme -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource Carte}" CornerRadius="6" Padding="12,6">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="True"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                <TextBlock x:Name="Fleche" Text="▸" Width="14" Foreground="{StaticResource Accent}"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Fleche" Property="Text" Value="▾"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                               Foreground="{StaticResource Pale}"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="Contenu" Margin="14,2,0,2" Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Contenu" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BoutonPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E8A33D"/>
            <Setter Property="BorderBrush" Value="#E8A33D"/>
            <Setter Property="Foreground" Value="#1E1F22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Application.Resources>
</Application>
