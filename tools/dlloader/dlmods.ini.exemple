; winmm.dll proxy configuration (Dying Light 1.55 mod loader).
; Place it in the game folder, next to winmm.dll.

[loader]
; Mod DLLs loaded at game startup, in order, separated by ";".
; Paths relative to the game folder, or absolute ("X:\..."). Default if absent: dlcoop_reseau.dll;coop6.dll
Mods=dlcoop_reseau.dll;coop6.dll

[env]
; Settings placed as environment variables of the game process BEFORE the mods are loaded.
; The mods read them first (coop6.dll: COOP6_*, dlcoop_reseau.dll: DLF_*), otherwise their own .ini.
; The launcher rewrites this section on each launch. Examples:
COOP6_Places=7
COOP6_Difficulte=1
COOP6_Couleurs=1
COOP6_Hud=1
; DLF_INDEX=0 = main instance (real Steam identity). Leave 0 for a plain launch.
DLF_INDEX=0
