; fantome.exe settings (copied to fantome.ini next to the exe by build.ps1 if it does not exist)
[fantome]
; Game executable (launched as-is, never modified)
Jeu=C:\Program Files (x86)\Steam\steamapps\common\Dying Light\DyingLightGame.exe
; 1 = each instance takes the address 127.0.0.(number+1) on the game ports
;     (also launch the host with "fantome.exe hote")
Bouclage=1
; 0 = ghosts without sound (/nosound)
SonFantomes=0
; Arguments added for every instance (-nologos is always added)
Arguments=
; Arguments added for the ghosts only (less memory for textures)
ArgumentsFantomes=-texStreamMemMB 512
; Mod DLLs loaded at startup, after fantome.dll (separated by ";", relative to fantome.exe)
; e.g.: Mods=..\mods\coop6\coop6.dll
Mods=
